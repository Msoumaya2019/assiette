    </scenes>
    <resources>
        <!-- 120 pt : la taille intrinseque du logo, que contentMode="center"
             respecte a la lettre. Elle doit donc valoir exactement le 1x de
             LaunchImage.png, sinon le logo est dessine a la mauvaise echelle. -->
        <image name="LaunchImage" width="120" height="120"/>
        <!-- Couleur nommee, definie dans Assets.xcassets/LaunchBackground.colorset
             avec sa variante sombre : un storyboard ne lit pas le theme de
             l'application. La valeur ci-dessous n'est qu'un repli pour les
             outils qui ne resolvent pas le catalogue. -->
        <namedColor name="LaunchBackground">
            <color red="0.98431372549019602" green="0.96862745098039216" blue="0.95294117647058818" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
        </namedColor>
    </resources>
</document>

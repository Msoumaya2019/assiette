<?xml version="1.0" encoding="utf-8"?>
<!-- Ecran de demarrage avant Android 12. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- La couleur, resolue en clair ou en sombre par le systeme. -->
    <item android:drawable="@color/splash_background" />

    <!-- L'assiette, centree. Une image plutot qu'un dessin vectoriel : le logo
         n'a aucune raison d'etre recalcule a chaque lancement. -->
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_logo" />
    </item>
</layer-list>
